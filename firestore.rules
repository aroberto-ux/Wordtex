rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  Reglas de Firestore para LaTeX visual.
//  Pégalas en: Firebase Console → Firestore Database → Reglas → Publicar.
//
//  Si compartes el proyecto con otra página (p. ej. presentaciones), NO borres
//  sus reglas: añade solo el bloque «match /documentos/{did}» dentro de
//  «match /databases/{database}/documents { … }».
//
//  Hay dos variantes; deja activa solo UNA (comenta la otra).
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ Editor de documentos LaTeX (otra página del mismo proyecto) ══
    // Variante A · Abierta con enlace: cualquier sesión anónima puede ver y editar.
    // Requiere habilitar «Anónimo» en Authentication → Método de acceso.

    function ingresado() { return request.auth != null; }

    match /documentos/{did} {
      allow read: if ingresado();
      allow create: if ingresado()
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() <= 160;
      allow update: if ingresado()
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() <= 160;
      allow delete: if ingresado();

      match /bloques/{bid} {
        allow read: if ingresado();
        allow write: if ingresado();
      }

      // Presencia: cada persona solo escribe su propio documento.
      match /presencia/{uid} {
        allow read: if ingresado();
        allow write: if ingresado() && request.auth.uid == uid;
      }
    }

    // ─── Banco de problemas (app EjerciciosMecSO) ──────────────
    // SOLO LECTURA para cualquier visitante (sesión anónima) y escritura
    // únicamente para las cuentas de Google listadas en el documento
    //   config/acceso   →   { editores: ['persona1@gmail.com', ...] }
    // (correos en minúsculas). Ese documento se crea y edita a mano en la
    // consola de Firebase; nadie puede escribirlo desde la web.
    function esEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/acceso)
        && request.auth.token.email.lower()
             in get(/databases/$(database)/documents/config/acceso).data.editores;
    }

    match /config/{doc} {
      allow read: if ingresado();
      allow write: if false;
    }

    match /asignaturas/{aid} {
      allow read: if ingresado();
      allow create, update: if esEditor()
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 120;
      allow delete: if esEditor();

      match /problemas/{pid} {
        allow read: if ingresado();
        allow delete: if esEditor();
        allow create, update: if esEditor()
          && request.resource.data.enunciado is string
          && request.resource.data.enunciado.size() <= 20000;
      }
    }

    // Variante abierta del banco (cualquiera con el enlace edita). Solo si
    // dejas  autenticacion: 'anonima'  en firebase-config.js: sustituye el
    // bloque anterior por este.
    //
    // match /asignaturas/{aid} {
    //   allow read: if ingresado();
    //   allow create, update: if ingresado()
    //     && request.resource.data.nombre is string
    //     && request.resource.data.nombre.size() <= 120;
    //   allow delete: if ingresado();
    //   match /problemas/{pid} {
    //     allow read, delete: if ingresado();
    //     allow create, update: if ingresado()
    //       && request.resource.data.enunciado is string
    //       && request.resource.data.enunciado.size() <= 20000;
    //   }
    // }

    // ═══ Editor de documentos · Variante B (solo personas autorizadas) ══
    // Solo afecta a «documentos»: el banco de problemas ya usa su propia lista
    // (config/acceso). Descomenta este bloque y quita el match /documentos de arriba.
    //
    // function autorizado() {
    //   return request.auth != null
    //     && request.auth.token.email_verified == true
    //     && request.auth.token.email in [
    //       'persona1@gmail.com',
    //       'persona2@unal.edu.co'
    //     ];
    // }
    // match /documentos/{did} {
    //   allow read, write: if autorizado();
    //   match /bloques/{bid} { allow read, write: if autorizado(); }
    //   match /presencia/{uid} {
    //     allow read: if autorizado();
    //     allow write: if autorizado() && request.auth.uid == uid;
    //   }
    // }
  }
}
